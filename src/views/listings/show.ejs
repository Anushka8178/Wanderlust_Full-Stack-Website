<% layout("/layouts/boilerplate") %>
<script>
    const mapToken="<%= process.env.MAPTOKEN %>";
    const listing= <%- JSON.stringify(listing) %>;
    

  

</script>
        <div class="row mt-4 mb-4">
            <div class="col-12">
                <h2 class="mb-3"><%= listing.title %></h2>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-lg-8 offset-lg-2">
                <div class="card listing-card show-card">
                    <img src="<%= listing.image.url || 'https://plus.unsplash.com/premium_photo-1689609950112-d66095626efb?w=1000&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8aG9tZXxlbnwwfHwwfHx8MA%3D%3D' %>" class="card-img-top show-img" alt="image">
                    <div class="card-body p-4">
                        <p class="card-text mb-2">
                            <strong>Hosted by:</strong> <i><%= listing.owner.username %></i>
                        </p>
                        <p class="card-text mb-3">
                            <%= listing.description %>
                        </p>
                        <div class="d-flex flex-wrap gap-3 mb-3 align-items-center">
                            <p class="card-text mb-0">
                                <strong>&#8377;<%= listing.price.toLocaleString("en-IN") %></strong> / night
                            </p>
                            <p class="card-text mb-0">
                                <span class="badge bg-secondary"><%= listing.category %></span>
                            </p>
                        </div>
                        <p class="card-text mb-3">
                            <i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %>
                        </p>
                        <p class="card-text mb-3">
                            <i class="fa-solid fa-door-open"></i> 
                            <strong><%= roomLimit %></strong> room(s) total
                            <small class="text-muted">(Availability depends on selected dates)</small>
                        </p>

                        <% if(currUser && !listing.owner._id.equals(currUser._id)) { %>
                            <div class="mt-3">
                                <h5 class="mb-3">Book Your Stay</h5>
                                <div class="row g-3 mb-3">
                                    <div class="col-md-4">
                                        <label for="checkInDate" class="form-label">Check-in</label>
                                        <input type="date" class="form-control" id="checkInDate" name="checkIn" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="checkOutDate" class="form-label">Check-out</label>
                                        <input type="date" class="form-control" id="checkOutDate" name="checkOut" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="guests" class="form-label">Guests</label>
                                        <input type="number" class="form-control" id="guests" name="guests" value="1" min="1" required>
                                    </div>
                                </div>
                                <button type="button" id="bookNowBtn" class="btn btn-dark w-100">
                                    Book Now &amp; Pay Securely
                                </button>
                            </div>
                        <% } %>

                    </div>
                </div>
            </div>
        </div>

        <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
            <div class="row mb-4">
                <div class="col-lg-8 offset-lg-2">
                    <div class="card mb-4">
                        <div class="card-body p-4">
                            <h5 class="mb-3">Mark Dates as Unavailable</h5>
                            <form action="/listings/<%= listing._id %>/unavailable" method="POST" class="row g-3">
                                <div class="col-md-6">
                                    <label for="startDate" class="form-label">Start Date</label>
                                    <input type="date" class="form-control" id="startDate" name="startDate" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="endDate" class="form-label">End Date</label>
                                    <input type="date" class="form-control" id="endDate" name="endDate" required>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-dark">Mark as Unavailable</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-body p-4">
                            <h5 class="mb-3">Unavailable Dates</h5>
                            <% if(listing.unavailableDates && listing.unavailableDates.length > 0) { %>
                                <ul class="list-group">
                                    <% listing.unavailableDates.forEach(dateRange => { %>
                                        <li class="list-group-item">
                                            <%= new Date(dateRange.start).toLocaleDateString() %> to 
                                            <%= new Date(dateRange.end).toLocaleDateString() %>
                                        </li>
                                    <% }); %>
                                </ul>
                            <% } else { %>
                                <p class="text-muted mb-0">No dates marked as unavailable</p>
                            <% } %>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mb-4">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
                        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
                            <button class="btn btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        <% } %>

        <div class="row mb-4">
            <div class="col-lg-8 offset-lg-2">
                <div class="review">
                <hr class="my-4">              
                
                <% if(currUser) { %>
                
                    <h4 class="mb-4">Leave a Review</h4>
                    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                        <div class="mb-4">
                            <label for="rating" class="form-label fw-bold mb-2">Rating</label> 
                            <fieldset class="starability-slot" id="rating-fieldset">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="" aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                            <div class="invalid-feedback" id="rating-feedback" style="display: none;">
                                Please select a rating.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="comment" class="form-label fw-bold mb-2">Comments</label>
                            <textarea name="review[comment]" id="comment" class="form-control" rows="5" required></textarea>
                            <div class="invalid-feedback">
                                Please add some comments for review
                            </div>
                        </div>
                        <div class="mb-3">
                            <button type="submit" class="btn btn-dark">Submit Review</button>
                        </div>
                    </form>
                <% } %>
                <hr class="my-5">
                <% if(listing.reviews.length > 0) { %>
                    <h5 class="mb-4"><b>All Reviews</b></h5>
                    <div class="row g-4">
                        <% for (review of listing.reviews) { %>
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-body p-3">
                                        <h6 class="card-title mb-2">@<%= review.author.username %></h6>
                                        <p class="starability-result card-text mb-2" data-rating=<%= review.rating %>>
                                            Rated: <%= review.rating %> stars
                                        </p>
                                        <p class="card-text"><%= review.comment %></p>
                                        <% if(currUser && review.author._id.equals(currUser._id)) { %>
                                            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                <button class="btn btn-sm btn-outline-danger mt-2">Delete</button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <p class="text-muted mb-0">No reviews yet. Be the first to review!</p>
                <% } %>
                </div>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-lg-8 offset-lg-2">
                <h3 class="mb-3">Where you'll be</h3>
                <div id="map"></div>
            </div>
        </div>
        
<script src="/js/map.js"></script>

<!-- Razorpay Checkout Script -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
    // Razorpay Payment Integration
    <% if(currUser && !listing.owner._id.equals(currUser._id)) { %>
    // Wait for DOM and Razorpay script to load
    window.addEventListener('load', function() {
        // Check if Razorpay is loaded
        if (typeof Razorpay === 'undefined') {
            console.error('Razorpay SDK not loaded. Please check the script tag.');
            const bookNowBtn = document.getElementById('bookNowBtn');
            if (bookNowBtn) {
                bookNowBtn.disabled = true;
                bookNowBtn.textContent = 'Payment unavailable';
            }
            return;
        }
        
        console.log('Razorpay SDK loaded successfully');
        
        const bookNowBtn = document.getElementById('bookNowBtn');
        if (!bookNowBtn) {
            console.error('Book Now button not found');
            return;
        }
        
        bookNowBtn.addEventListener('click', async function(e) {
            e.preventDefault();
            const listingId = '<%= listing._id %>';
            const button = this;
            const originalText = button.textContent;
            
            // Disable button and show loading
            button.disabled = true;
            button.textContent = 'Processing...';
            
            try {
                // Get booking details
                const checkIn = document.getElementById('checkInDate').value;
                const checkOut = document.getElementById('checkOutDate').value;
                const guests = document.getElementById('guests').value || 1;
                
                if (!checkIn || !checkOut) {
                    alert('Please select check-in and check-out dates');
                    button.disabled = false;
                    button.textContent = originalText;
                    return;
                }
                
                if (new Date(checkOut) <= new Date(checkIn)) {
                    alert('Check-out date must be after check-in date');
                    button.disabled = false;
                    button.textContent = originalText;
                    return;
                }
                
                console.log('Creating order for listing:', listingId);
                
                // Create order
                const response = await fetch(`/listings/${listingId}/create-order`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'same-origin',
                    body: JSON.stringify({ checkIn, checkOut, guests })
                });
                
                const responseData = await response.json();
                
                if (!response.ok) {
                    console.error('Order creation failed:', responseData);
                    const errorMsg = responseData.error || 'Failed to create order';
                    
                    // Check if it's a room availability error
                    if (errorMsg.includes('room') || errorMsg.includes('booked') || errorMsg.includes('already booked')) {
                        alert(errorMsg);
                    } else {
                        alert('Failed to create payment order: ' + errorMsg);
                    }
                    button.disabled = false;
                    button.textContent = originalText;
                    return;
                }
                
                console.log('Order created:', responseData);
                
                // Razorpay options
                const options = {
                    key: responseData.keyId,
                    amount: responseData.amount,
                    currency: responseData.currency,
                    name: 'Wanderlust',
                    description: '<%= listing.title %>',
                    order_id: responseData.orderId,
                    handler: function(response) {
                        console.log('=== RAZORPAY PAYMENT SUCCESS ===');
                        console.log('Full Razorpay response object:', response);
                        console.log('Response keys:', Object.keys(response));
                        
                        // Extract payment details - try all possible field names
                        const orderId = response.razorpay_order_id || response.order_id || response.razorpayOrderId;
                        const paymentId = response.razorpay_payment_id || response.payment_id || response.razorpayPaymentId;
                        const signature = response.razorpay_signature || response.signature || response.razorpaySignature;
                        
                        console.log('Extracted values:', {
                            orderId: orderId,
                            paymentId: paymentId,
                            hasSignature: !!signature,
                            checkIn: checkIn,
                            checkOut: checkOut,
                            guests: guests
                        });
                        
                        if (!orderId || !paymentId) {
                            console.error('CRITICAL: Missing payment IDs!', {
                                orderId: orderId,
                                paymentId: paymentId,
                                fullResponse: response
                            });
                            alert('ERROR: Payment succeeded but details missing. Payment ID: ' + (paymentId || 'UNKNOWN') + '\n\nPlease contact support immediately!');
                            return;
                        }
                        
                        const paymentData = {
                            razorpay_order_id: orderId,
                            razorpay_payment_id: paymentId,
                            razorpay_signature: signature,
                            checkIn: checkIn,
                            checkOut: checkOut,
                            guests: guests
                        };
                        
                        console.log('Sending to server:', paymentData);
                        
                        // Show loading state
                        button.disabled = true;
                        button.textContent = 'Verifying payment...';
                        
                        // Verify payment on server (async operation)
                        fetch(`/listings/${listingId}/verify-payment`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            credentials: 'same-origin',
                            body: JSON.stringify(paymentData)
                        })
                        .then(async (verifyResponse) => {
                            console.log('Server response status:', verifyResponse.status);
                            let verifyData;
                            try {
                                verifyData = await verifyResponse.json();
                            } catch (jsonErr) {
                                console.error('Failed to parse JSON response:', jsonErr);
                                const text = await verifyResponse.text();
                                console.error('Response text:', text);
                                throw new Error('Invalid server response: ' + text.substring(0, 100));
                            }
                            
                            console.log('Verification response:', verifyData);
                            
                            if (verifyResponse.ok && verifyData.success) {
                                // Redirect to confirmation page
                                console.log('✓ SUCCESS! Redirecting to:', verifyData.redirectUrl);
                                window.location.href = verifyData.redirectUrl;
                            } else {
                                console.error('✗ Payment verification failed:', verifyData);
                                const errorMsg = verifyData.error || 'Unknown error';
                                
                                // Check if it's a room availability error
                                if (errorMsg.includes('room') || errorMsg.includes('booked') || errorMsg.includes('already booked')) {
                                    alert(errorMsg + '\n\nYour payment will be refunded. Please try booking different dates.');
                                } else {
                                    alert('Payment verification failed: ' + errorMsg + '\n\nYour payment was successful (Payment ID: ' + paymentId + '). Please contact support.');
                                }
                                button.disabled = false;
                                button.textContent = originalText;
                                window.location.href = `/listings/${listingId}?error=true`;
                            }
                        })
                        .catch((err) => {
                            console.error('✗ Verification error:', err);
                            alert('Payment verification error: ' + err.message + '\n\nYour payment was successful (Payment ID: ' + (paymentId || 'UNKNOWN') + '). Please contact support immediately!');
                            window.location.href = `/listings/${listingId}?error=true`;
                        });
                    },
                    prefill: {
                        name: '<%= currUser.username || "" %>',
                        email: '<%= (currUser.email || "").replace(/"/g, "&quot;") %>'
                    },
                    theme: {
                        color: '#000000'
                    },
                    modal: {
                        ondismiss: function() {
                            button.disabled = false;
                            button.textContent = originalText;
                        }
                    }
                };
                
                const razorpay = new Razorpay(options);
                razorpay.on('payment.failed', function(response) {
                    console.error('Payment failed:', response);
                    alert('Payment failed: ' + (response.error.description || 'Please try again.'));
                    button.disabled = false;
                    button.textContent = originalText;
                });
                
                // Handle modal close/cancel
                razorpay.on('modal.closed', function() {
                    console.log('Payment modal closed');
                    button.disabled = false;
                    button.textContent = originalText;
                });
                
                razorpay.open();
                
            } catch (error) {
                console.error('Payment error:', error);
                alert('Failed to initiate payment: ' + error.message);
                button.disabled = false;
                button.textContent = originalText;
            }
        });
    });
    <% } %>
    
    // Set minimum date for booking dates
    (function() {
        const today = new Date().toISOString().split('T')[0];
        const checkInInput = document.getElementById('checkInDate');
        const checkOutInput = document.getElementById('checkOutDate');
        const startDateInput = document.getElementById('startDate');
        const endDateInput = document.getElementById('endDate');
        
        if (checkInInput && checkOutInput) {
            checkInInput.min = today;
            
            checkInInput.addEventListener('change', () => {
                const checkInDate = checkInInput.value;
                checkOutInput.min = checkInDate;
                if (checkOutInput.value && checkOutInput.value <= checkInDate) {
                    const nextDay = new Date(checkInDate);
                    nextDay.setDate(nextDay.getDate() + 1);
                    checkOutInput.value = nextDay.toISOString().split('T')[0];
                }
            });
        }
        
        if (startDateInput && endDateInput) {
            startDateInput.min = today;
            
            startDateInput.addEventListener('change', () => {
                endDateInput.min = startDateInput.value;
                if (endDateInput.value && endDateInput.value < startDateInput.value) {
                    endDateInput.value = startDateInput.value;
                }
            });
        }
    })();
</script>
    
    


    
    
    

