<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-success">
                <div class="card-header bg-success text-white text-center py-4">
                    <h2 class="mb-0">✓ Booking Confirmed!</h2>
                </div>
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
                        <h4 class="mt-3">Thank you for your booking!</h4>
                        <p class="text-muted">Your payment has been processed successfully.</p>
                    </div>

                    <hr class="my-4">

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5 class="text-muted mb-3">Booking Details</h5>
                            <p><strong>Booking ID:</strong> <%= booking._id %></p>
                            <p><strong>Payment ID:</strong> <%= booking.razorpayPaymentId %></p>
                            <p><strong>Status:</strong> <span class="badge bg-success"><%= booking.status %></span></p>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-muted mb-3">Stay Details</h5>
                            <p><strong>Check-in:</strong> <%= new Date(booking.checkIn).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                            <p><strong>Check-out:</strong> <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                            <p><strong>Guests:</strong> <%= booking.guests %></p>
                            <% 
                                const nights = Math.ceil((new Date(booking.checkOut) - new Date(booking.checkIn)) / (1000 * 60 * 60 * 24));
                            %>
                            <p><strong>Nights:</strong> <%= nights %></p>
                        </div>
                    </div>

                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <h5 class="mb-3">Property Information</h5>
                            <h6><%= booking.listing.title %></h6>
                            <p class="text-muted mb-2"><%= booking.listing.location %>, <%= booking.listing.country %></p>
                            <p class="mb-0"><strong>Price per night:</strong> ₹<%= booking.listing.price.toLocaleString("en-IN") %></p>
                        </div>
                    </div>

                    <div class="card bg-primary text-white mb-4">
                        <div class="card-body text-center">
                            <h4 class="mb-0">Total Amount Paid</h4>
                            <h2 class="mb-0">₹<%= booking.totalAmount.toLocaleString("en-IN") %></h2>
                        </div>
                    </div>

                    <div class="text-center">
                        <a href="/listings/<%= booking.listing._id %>" class="btn btn-outline-dark me-2">View Listing</a>
                        <a href="/listings" class="btn btn-dark">Browse More Listings</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
