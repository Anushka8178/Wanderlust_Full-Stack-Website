<style>
  .btn-search{
    background-color: rgb(219, 13, 10);
    color: rgb(255, 255, 255);
  }
  .btn-search:hover{
    background-color: rgb(180, 10, 8);
    color: rgb(255, 255, 255);
  }
  .btn-search{
    display: inline;
    margin-right: 0.6rem;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
    width: 7rem;
    font-size: 1rem;
  }
  .search-input{
    border-radius: 20px;
    padding: 0.5rem 1rem 0.5rem 1rem;
    width: 20rem;  
  }
  .date-input{
    border-radius: 20px;
    padding: 0.5rem 1rem 0.5rem 1rem;
    width: 13rem;  
  }

  /* Responsive styles */
  @media (max-width: 991px) {
    .navbar-collapse {
      background-color: rgba(255, 255, 255, 0.95);
      padding: 1rem;
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    .search-form {
      flex-direction: column;
      gap: 0.5rem;
      width: 100%;
    }
    .search-input, .date-input, .btn-search {
      width: 100%;
      margin: 0.25rem 0;
    }
  }

  /* Ensure dropdown menu items are visible */
  .navbar-nav .nav-link {
    color: #333;
    padding: 0.5rem 1rem;
  }
  .navbar-nav .nav-link:hover {
    background-color: rgba(0,0,0,0.05);
    border-radius: 5px;
  }
</style>


<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
    <div class="container-fluid">
      <a class="navbar-brand" href="/listings"><i class="fa-solid fa-snowflake"></i></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">

          <a class="nav-link" href="/listings">Explore</a>
        </div>

        
        <div class="navbar-nav ms-auto">
          <form class="d-flex search-form" role="search" action="/listings" method="GET">
            <input class="form-control me-2 search-input" 
                   type="search" 
                   name="search" 
                   placeholder="Search destinations, properties..." 
                   value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                   autocomplete="off">
            <input class="form-control me-1 date-input" 
                   type="date" 
                   name="checkin" 
                   placeholder="Check-in" 
                   value="<%= typeof checkin !== 'undefined' ? checkin : '' %>">
            <input class="form-control me-1 date-input" 
                   type="date" 
                   name="checkout" 
                   placeholder="Check-out" 
                   value="<%= typeof checkout !== 'undefined' ? checkout : '' %>">
            <button class="btn btn-search" type="submit">
              <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
          </form>
        </div>

        

        <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Airbnb your home</a>

        <% if(!currUser) { %>
          <a class="nav-link "  href="/signup"><b>SignUp</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
          <% } %>
          <% if(currUser) { %>
          <a class="nav-link" href="/logout"><b>Logout</b></a>
          <% } %>
        </div>
        </div>


      </div>

      
    </div>
  </nav>

<script>
    // Set minimum date for check-in and check-out
    const today = new Date().toISOString().split('T')[0];
    const checkinInput = document.querySelector('input[name="checkin"]');
    const checkoutInput = document.querySelector('input[name="checkout"]');
    
    if (checkinInput && checkoutInput) {
        checkinInput.min = today;
        
        checkinInput.addEventListener('change', () => {
            checkoutInput.min = checkinInput.value;
            if (checkoutInput.value && checkoutInput.value < checkinInput.value) {
                checkoutInput.value = checkinInput.value;
            }
        });

        // If checkout date is already set, ensure it's not before checkin
        if (checkoutInput.value && checkinInput.value) {
            if (checkoutInput.value < checkinInput.value) {
                checkoutInput.value = checkinInput.value;
            }
        }
    }
</script>
