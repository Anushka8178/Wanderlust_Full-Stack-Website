<% layout("/layouts/boilerplate") %>
<body>
    <div class="row mt-2">
        <div class="col-8 offset-2">
            <h3>Edit your Listing</h3> <br>
        <form method="POST" action="/listings/<%= listing._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="mb-3">
            <label for="title" class="form-label">Title</label><br>
            <input value="<%= listing.title %>" name="listing[title]" class="form-control" required>
            <div class="valid-feedback">Title looks good!</div>

        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label><br>
            <input type="textarea" name="listing[description]" value="<%= listing.description %>" class="form-control" required>
            <div class="invalid-feedback">Please enter a short valid description</div>

        </div>

        <div class="mb-3">
            <label for="category" class="form-label">Category</label><br>
            <select name="listing[category]" class="form-control" required>
                <option value="">Select a category</option>
                <option value="Budget Rooms" <%= listing.category === "Budget Rooms" ? "selected" : "" %>>Budget Rooms</option>
                <option value="Heart of the City" <%= listing.category === "Heart of the City" ? "selected" : "" %>>Heart of the City</option>
                <option value="Mountains" <%= listing.category === "Mountains" ? "selected" : "" %>>Mountains</option>
                <option value="Castles" <%= listing.category === "Castles" ? "selected" : "" %>>Castles</option>
                <option value="Beaches" <%= listing.category === "Beaches" ? "selected" : "" %>>Beaches</option>
                <option value="Forest Resorts" <%= listing.category === "Forest Resorts" ? "selected" : "" %>>Forest Resorts</option>
                <option value="Bed & Breakfasts" <%= listing.category === "Bed & Breakfasts" ? "selected" : "" %>>Bed & Breakfasts</option>
                <option value="Vineyards" <%= listing.category === "Vineyards" ? "selected" : "" %>>Vineyards</option>
            </select>
            <div class="invalid-feedback">Please select a category</div>
        </div>

        <div class="mb-3">
            Original Listing Image <br> <br>
            <img src="<%= originalImageUrl %>" alt="">
        </div>

        <div class="mb-3">
            <label for="image" class="form-label">Upload New Image</label><br>
            <input name="listing[image]" type="file" class="form-control" >

        </div>
        <div>
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label">Price</label><br>
                <input type="number" name="listing[price]" value="<%= listing.price %>" class="form-control" required>
                <div class="invalid-feedback">Please enter a valid price</div>
    
            </div>      
    
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label">Country</label><br>
                <input type="text" name="listing[country]" value="<%= listing.country %>" class="form-control" required>
                <div class="invalid-feedback">Please enter the country name</div>
    
            </div>

        </div>

        

        <div class="mb-3">
            <label for="location" class="form-label">Location</label><br>
            <input type="text" name="listing[location]" value="<%= listing.location %>" class="form-control" required>
            <div class="invalid-feedback">Please enter a valid location</div>

        </div>
        
        
        
        <button class="btn btn-dark update-btn mt-3">Update</button><br><br>
    </form>
    
    
    

    </div>
    
    

        </div>

